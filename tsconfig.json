{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "aws-lambda"]
  },
  "include": ["src/**/*.ts", "config/**/*.ts", "scripts/**/*.ts", "infrastructure/cdk/**/*.ts", "tests/**/*.ts"]
}
